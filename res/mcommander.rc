#include <winver.h>

// build.rs passes the version from Cargo.toml.
#ifndef MC_VERSION
#define MC_VERSION 0,0,0,0
#define MC_VERSION_STR "0.0.0"
#endif

1 ICON "mcommander.ico"
1 24 "mcommander.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MC_VERSION
PRODUCTVERSION MC_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mad-Mange"
      VALUE "FileDescription", "MCommander file manager"
      VALUE "FileVersion", MC_VERSION_STR
      VALUE "InternalName", "MCommander"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "MCommander.exe"
      VALUE "ProductName", "MCommander"
      VALUE "ProductVersion", MC_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
